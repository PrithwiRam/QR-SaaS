DATABASE_URL="postgresql://qrsaas:qrsaas_pass@localhost:5432/qrsaas"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-to-a-32-byte-random-string-abc123"
JWT_REFRESH_SECRET="another-32-byte-random-string-xyz789"
PORT=4000

# ─── FRONTEND_URL ───────────────────────────────────────────────────────────────
# CRITICAL: This URL is embedded inside every QR code image.
# Development: http://localhost:3000
# Production (Railway): https://qr-saa-s-web.vercel.app  ← must match your Vercel deployment
# If this is wrong, all QR codes will encode the wrong domain.
FRONTEND_URL="http://localhost:3000"

# Storage — using local filesystem for MVP (set to "local")
STORAGE_MODE="local"
PUBLIC_URL="http://localhost:4000"

# Cloudflare R2 (optional, leave blank for local mode)
R2_ENDPOINT=""
R2_ACCESS_KEY=""
R2_SECRET_KEY=""
R2_BUCKET="qrsaas-media"
R2_PUBLIC_URL=""

# Seed admin credentials
SEED_ADMIN_EMAIL="admin@qrsaas.com"
SEED_ADMIN_PASSWORD="admin123"
