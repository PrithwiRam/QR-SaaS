// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users ──────────────────────────────────────────────────────
model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  role         UserRole    @default(RESTAURANT_ADMIN)
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  restaurantId String?
  isActive     Boolean     @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([restaurantId])
}

enum UserRole {
  SUPER_ADMIN
  RESTAURANT_ADMIN
}

// ─── Restaurants ────────────────────────────────────────────────
model Restaurant {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  logoUrl    String?
  address    String?
  phone      String?
  isActive   Boolean  @default(true)
  themeColor String   @default("#6c63ff")
  menuTheme  String   @default("classic")
  createdAt  DateTime @default(now())

  users         User[]
  categories    MenuCategory[]
  menuItems     MenuItem[]
  tables        Table[]
  orders        Order[]
  customers     Customer[]
  offers        Offer[]
  loyaltyConfig LoyaltyConfig?
  campaigns     MarketingCampaign[]
}

// ─── Menu categories ────────────────────────────────────────────
model MenuCategory {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  name         String
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  items        MenuItem[]

  @@index([restaurantId])
  @@unique([restaurantId, name])
}

// ─── Menu items ─────────────────────────────────────────────────
model MenuItem {
  id           String       @id @default(uuid())
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  category     MenuCategory @relation(fields: [categoryId], references: [id])
  categoryId   String
  name         String
  description  String?
  price        Decimal      @db.Decimal(10, 2)
  imageUrl     String?
  isAvailable  Boolean      @default(true)
  sortOrder    Int          @default(0)
  orderItems   OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
  @@index([restaurantId, isAvailable])
}

// ─── Tables ─────────────────────────────────────────────────────
model Table {
  id             String     @id @default(uuid())
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId   String
  tableNumber    Int
  qrToken        String     @unique @default(uuid())
  qrImageUrl     String?
  isActive       Boolean    @default(true)
  tokenUpdatedAt DateTime   @default(now())
  orders         Order[]

  @@index([restaurantId])
  @@index([qrToken])
  @@unique([restaurantId, tableNumber])
}

// ─── Orders ─────────────────────────────────────────────────────
model Order {
  id             String      @id @default(uuid())
  restaurant     Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId   String
  table          Table       @relation(fields: [tableId], references: [id])
  tableId        String
  tableNumber    Int
  status         OrderStatus @default(PENDING)
  customerNote   String?
  totalAmount    Decimal     @db.Decimal(10, 2)
  isPaid         Boolean     @default(false)
  placedAt       DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discountCode   String?
  discountAmount Decimal?    @db.Decimal(10, 2)

  @@index([restaurantId, status])
  @@index([restaurantId, placedAt])
  @@index([restaurantId, placedAt, status])
  @@index([customerId])
  @@index([placedAt])
}

enum OrderStatus {
  PENDING
  PREPARING
  SERVED
  CANCELLED
}

// ─── Order items ────────────────────────────────────────────────
model OrderItem {
  id            String   @id @default(uuid())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId    String
  nameSnapshot  String
  priceSnapshot Decimal  @db.Decimal(10, 2)
  quantity      Int
  subtotal      Decimal  @db.Decimal(10, 2)

  @@index([orderId])
}

// ─── Customer CRM & Loyalty ─────────────────────────────────────
model Customer {
  id               String     @id @default(uuid())
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId     String
  name             String
  phone            String
  loyaltyPoints    Int        @default(0)
  visitCount       Int        @default(0)
  consentMarketing Boolean    @default(false)
  lastOrderAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  orders           Order[]

  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@index([restaurantId, createdAt])
}

model Offer {
  id             String     @id @default(uuid())
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId   String
  title          String
  description    String
  code           String
  discountType   String     @default("PERCENTAGE") // PERCENTAGE or FLAT
  discountValue  Decimal    @db.Decimal(10, 2)
  pointsRequired Int        @default(0)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([restaurantId])
}

// ─── Loyalty Configuration ───────────────────────────────────────
model LoyaltyConfig {
  id                String     @id @default(uuid())
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId      String     @unique
  isEnabled         Boolean    @default(true)
  pointsPerRupee    Float      @default(0.1)
  minOrderForPoints Decimal    @default(0) @db.Decimal(10, 2)
  pointsToRupee     Float      @default(0.1)
  minPointsRedeem   Int        @default(100)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

// ─── WhatsApp Marketing Campaigns ────────────────────────────────
model MarketingCampaign {
  id             String     @id @default(uuid())
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId   String
  name           String
  message        String
  segment        String     @default("ALL")
  status         String     @default("DRAFT")
  recipientCount Int        @default(0)
  sentAt         DateTime?
  createdAt      DateTime   @default(now())

  @@index([restaurantId])
  @@index([restaurantId, createdAt])
}
